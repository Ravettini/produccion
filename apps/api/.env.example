PORT=4000
JWT_SECRET=cambiar-por-secreto-seguro-en-produccion

# PostgreSQL (obligatorio en producción y desarrollo normal)
DATABASE_URL=postgresql://usuario:password@localhost:5432/eventos_gobierno?schema=public

# Solo desarrollo sin Postgres: true = datos en memoria (no usar en deploy)
NO_DATABASE=false

NODE_ENV=development

# IA — brief con Gemini (opcional)
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-3.1-flash-lite
